<main class="mx-auto max-w-6xl space-y-12 px-6 py-12">
  <header>
    <p class="mb-2 font-medium uppercase tracking-wide text-green-700">Batch Chef UI Kit</p>
    <h1 class="text-4xl font-bold text-gray-900">Recipe components</h1>
    <p class="mt-4 max-w-2xl text-lg text-gray-600">
      A simple showcase of the components used throughout Batch Chef.
    </p>
  </header>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Typography</h2>
    <h1 class="text-4xl font-bold text-gray-900">Heading level one</h1>
    <h2 class="text-2xl font-bold text-gray-900">Heading level two</h2>
    <p class="text-gray-700">This is body text for recipe descriptions and instructions.</p>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Buttons</h2>
    <div class="flex flex-wrap gap-4">
      <button type="button" class="rounded bg-green-600 px-4 py-2 font-medium text-white">Primary</button>
      <button type="button" class="rounded bg-gray-700 px-4 py-2 font-medium text-white">Secondary</button>
      <button type="button" class="rounded border border-green-600 px-4 py-2 font-medium text-green-700">Outline</button>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Form inputs</h2>
    <form class="max-w-md space-y-5 rounded border border-gray-200 bg-white p-6 shadow-sm">
      <div>
        <label for="recipe_name" class="mb-1 block font-medium text-gray-700">Recipe name</label>
        <input id="recipe_name" type="text" class="w-full rounded border border-gray-300 px-3 py-2">
      </div>
      <div>
        <label for="diameter" class="mb-1 block font-medium text-gray-700">Base diameter</label>
        <input id="diameter" name="diameter" type="number" min="1" step="1"
            class="w-full rounded border border-gray-300 px-3 py-2">
      </div>
      <fieldset>
        <legend class="mb-2 font-medium text-gray-700">Recipe steps</legend>
        <label class="flex items-center gap-2 text-gray-700">
          <input type="checkbox" name="recipe_steps[]" value="prepare"> Prepare ingredients
        </label>
        <label class="mt-2 flex items-center gap-2 text-gray-700">
          <input type="checkbox" name="recipe_steps[]" value="mix"> Mix the ingredients
        </label>
      </fieldset>
    </form>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900">Recipe card</h2>
    <article class="max-w-sm overflow-hidden rounded border border-gray-200 bg-white shadow-sm">
      <div class="flex h-48 items-center justify-center bg-gray-200 text-gray-500">Image placeholder</div>
      <div class="space-y-3 p-6">
        <h3 class="text-xl font-bold text-gray-900">Classic chocolate cake</h3>
        <p class="text-gray-600">A rich and simple cake for sharing.</p>
        <div class="space-y-1 text-sm text-gray-700">
          <p>Base diameter: 18cm</p>
          <p>Servings: 6</p>
        </div>
      </div>
    </article>
  </section>
</main>
