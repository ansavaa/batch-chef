<main class="min-h-screen bg-[#f8f1e7] text-[#443b35]">
  <div class="mx-auto max-w-6xl space-y-16 px-6 py-12 sm:px-10 lg:px-12">
    <header class="max-w-3xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-[#b86f62]">
        Batch Chef · набор компонентов
      </p>
      <h1 class="font-serif text-5xl leading-tight text-[#4b3832] sm:text-6xl">
        Готовим с заботой,<br>
        делимся с радостью.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[#75675e]">
        Тёплая коллекция компонентов для любимых рецептов, уютных кухонь
        и выпечки, которую хочется запомнить.
      </p>
    </header>

    <section class="space-y-8" aria-labelledby="typography-heading">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b86f62]">01</p>
        <h2 id="typography-heading" class="mt-2 font-serif text-3xl text-[#4b3832]">
          Типографика
        </h2>
      </div>

      <div class="grid gap-8 rounded-3xl border border-[#eadbce] bg-[#fffdf9] p-8 shadow-[0_16px_40px_rgba(113,82,62,0.08)] sm:grid-cols-3">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-[#a99588]">H1 · Заголовок</p>
          <h1 class="font-serif text-4xl leading-tight text-[#4b3832]">Домашний лимонный пирог</h1>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-[#a99588]">H2 · Раздел</p>
          <h2 class="font-serif text-2xl text-[#4b3832]">Соберите ингредиенты</h2>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-[#a99588]">Основной текст</p>
          <p class="leading-7 text-[#75675e]">
            Нежный мякиш, яркий аромат цитруса и спокойный день на кухне.
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-8" aria-labelledby="buttons-heading">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b86f62]">02</p>
        <h2 id="buttons-heading" class="mt-2 font-serif text-3xl text-[#4b3832]">Кнопки</h2>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button type="button" class="rounded-full bg-[#d98d78] px-6 py-3 font-semibold text-white shadow-[0_8px_18px_rgba(185,103,83,0.2)] transition hover:bg-[#c97967]">
          Начать готовку
        </button>
        <button type="button" class="rounded-full bg-[#9aaa88] px-6 py-3 font-semibold text-white shadow-[0_8px_18px_rgba(119,139,101,0.18)] transition hover:bg-[#879b75]">
          Сохранить рецепт
        </button>
        <button type="button" class="rounded-full border border-[#c9b8aa] bg-transparent px-6 py-3 font-semibold text-[#75675e] transition hover:border-[#b86f62] hover:bg-[#fff8f1] hover:text-[#a85f53]">
          + Добавить ингредиент
        </button>
      </div>
    </section>

    <section class="space-y-8" aria-labelledby="forms-heading">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b86f62]">03</p>
        <h2 id="forms-heading" class="mt-2 font-serif text-3xl text-[#4b3832]">Форма рецепта</h2>
      </div>

      <form class="grid gap-6 rounded-3xl border border-[#eadbce] bg-[#fffdf9] p-8 shadow-[0_16px_40px_rgba(113,82,62,0.08)] sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="recipe_title" class="mb-2 block text-sm font-semibold text-[#5f5048]">
            Название рецепта
          </label>
          <input id="recipe_title" type="text" placeholder="Например, миндальный кекс с мёдом"
              class="w-full rounded-2xl border border-[#decfc2] bg-[#fffaf5] px-5 py-4 text-lg text-[#4b3832] outline-none placeholder:text-[#b8aaa0] focus:border-[#d98d78] focus:ring-2 focus:ring-[#f0c4b8]">
        </div>

        <div>
          <label for="pan_diameter" class="mb-2 block text-sm font-semibold text-[#5f5048]">
            Диаметр формы, см
          </label>
          <input id="pan_diameter" name="diameter" type="number" min="1" step="1" placeholder="18"
              class="w-36 rounded-2xl border border-[#decfc2] bg-[#fffaf5] px-4 py-3 text-[#4b3832] outline-none placeholder:text-[#b8aaa0] focus:border-[#d98d78] focus:ring-2 focus:ring-[#f0c4b8]">
        </div>

        <div class="flex items-end">
          <label class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#f2eee5] px-4 py-3 text-[#5f5048]">
            <input type="checkbox" name="step_completed"
                class="h-5 w-5 rounded border-[#c9b8aa] accent-[#d98d78]">
            <span class="font-medium">Шаг выполнен</span>
          </label>
        </div>
      </form>
    </section>

    <section class="space-y-8" aria-labelledby="preview-heading">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b86f62]">04</p>
        <h2 id="preview-heading" class="mt-2 font-serif text-3xl text-[#4b3832]">Карточка рецепта</h2>
      </div>

      <article class="max-w-md overflow-hidden rounded-3xl border border-[#eadbce] bg-[#fffdf9] shadow-[0_18px_45px_rgba(113,82,62,0.12)]">
        <div class="flex h-64 items-center justify-center bg-[#ead8c8] text-[#947c6b]">
          <div class="text-center">
            <span class="text-5xl" aria-hidden="true">🍰</span>
            <p class="mt-3 text-sm font-semibold uppercase tracking-wider">Изображение рецепта</p>
          </div>
        </div>
        <div class="space-y-5 p-7">
          <div>
            <div class="mb-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-[#f6d9d0] px-3 py-1 text-xs font-semibold text-[#a85f53]">#десерт</span>
              <span class="rounded-full bg-[#e1ead8] px-3 py-1 text-xs font-semibold text-[#687b5b]">#домашняявыпечка</span>
            </div>
            <h3 class="font-serif text-3xl text-[#4b3832]">Клубничный облачный торт</h3>
          </div>
          <p class="leading-7 text-[#75675e]">
            Воздушные ванильные коржи, спелая клубника и нежный крем.
          </p>
          <div class="flex items-center gap-2 text-sm font-medium text-[#8b786b]">
            <span aria-hidden="true">◷</span>
            <span>Время приготовления · 45 минут</span>
          </div>
        </div>
      </article>
    </section>

    <section class="space-y-8" aria-labelledby="ingredients-heading">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b86f62]">05</p>
        <h2 id="ingredients-heading" class="mt-2 font-serif text-3xl text-[#4b3832]">Ингредиенты</h2>
      </div>

      <div class="max-w-xl divide-y divide-[#eadbce] rounded-3xl border border-[#eadbce] bg-[#fffdf9] px-6 shadow-[0_16px_40px_rgba(113,82,62,0.08)]">
        <div class="flex items-center justify-between gap-6 py-5">
          <span class="font-serif text-xl text-[#4b3832]">Сахар</span>
          <span class="flex-1 border-b border-dashed border-[#cdbbae]"></span>
          <span class="text-[#75675e]">200 г</span>
        </div>
        <div class="flex items-center justify-between gap-6 py-5">
          <span class="font-serif text-xl text-[#4b3832]">Пшеничная мука</span>
          <span class="flex-1 border-b border-dashed border-[#cdbbae]"></span>
          <span class="text-[#75675e]">250 г</span>
        </div>
        <div class="flex items-center justify-between gap-6 py-5">
          <span class="font-serif text-xl text-[#4b3832]">Свежая клубника</span>
          <span class="flex-1 border-b border-dashed border-[#cdbbae]"></span>
          <span class="text-[#75675e]">300 г</span>
        </div>
      </div>
    </section>
  </div>
</main>
