<main class="min-h-screen bg-stone-50 text-stone-800">
  <div class="mx-auto max-w-4xl space-y-12 p-8">
    <header class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-400">Batch Chef</p>
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <h1 class="font-serif text-4xl font-semibold text-stone-900">Ваша кухня, ваши рецепты</h1>
          <p class="mt-3 max-w-2xl text-stone-600">
            Создавайте рецепты, пересчитывайте ингредиенты под форму и готовьте по шагам.
          </p>
        </div>
        <% if logged_in? %>
          <%= link_to "Создать рецепт", new_recipe_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% else %>
          <%= link_to "Войти, чтобы создать рецепт", login_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% end %>
      </div>
    </header>

    <section aria-labelledby="catalog-heading" class="space-y-4">
      <div>
        <h2 id="catalog-heading" class="font-serif text-2xl font-semibold text-stone-900">Каталог</h2>
        <p class="mt-1 text-sm text-stone-500">Публичные рецепты сообщества Batch Chef.</p>
      </div>
      <%= form_with url: root_path, method: :get, class: "flex gap-3" do |form| %>
        <%= form.search_field :q, value: @catalog_query, placeholder: "Найти рецепт по названию",
            class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
        <%= form.submit "Найти", class: "rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400" %>
      <% end %>

      <% if @catalog_recipes.any? %>
        <div class="grid gap-5 md:grid-cols-2">
          <% @catalog_recipes.each do |recipe| %>
            <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
              <h3 class="font-serif text-2xl font-semibold text-stone-900">
                <%= link_to recipe.title, recipe_path(recipe), class: "hover:text-rose-600" %>
              </h3>
              <p class="mt-3 text-sm text-stone-500">
                Форма: <%= recipe.base_diameter.presence || "—" %> см ·
                Порции: <%= recipe.base_portions.presence || "—" %>
              </p>
              <%= link_to "Открыть рецепт", recipe_path(recipe),
                  class: "mt-4 inline-block text-rose-600 underline" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-600">
          Пока нет опубликованных рецептов.
        </p>
      <% end %>

      <%= link_to "Открыть весь каталог", public_recipes_path,
          class: "inline-block text-rose-600 underline" %>
    </section>
  </div>
</main>
