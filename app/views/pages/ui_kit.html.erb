<main class="min-h-screen bg-stone-50 text-stone-800">
  <div class="mx-auto max-w-4xl space-y-12 p-8">
    <header class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-400">Batch Chef</p>
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <h1 class="font-serif text-4xl font-semibold text-stone-900">Ваша кухня, ваши рецепты</h1>
          <p class="mt-3 max-w-2xl text-stone-600">
            Создавайте рецепты, пересчитывайте ингредиенты под форму и готовьте по шагам.
          </p>
        </div>
        <% if logged_in? %>
          <%= link_to "Создать рецепт", new_recipe_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% else %>
          <%= link_to "Войти, чтобы создать рецепт", login_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% end %>
      </div>
    </header>

    <section aria-labelledby="catalog-heading" class="space-y-4">
      <div>
        <h2 id="catalog-heading" class="font-serif text-2xl font-semibold text-stone-900">Каталог</h2>
        <p class="mt-1 text-sm text-stone-500">Пример карточки рецепта Batch Chef.</p>
      </div>
      <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm sm:flex">
        <div class="flex min-h-56 items-center justify-center bg-rose-100 px-8 text-center text-rose-500 sm:w-2/5">
          <div><span class="text-5xl" aria-hidden="true">🍓</span><p class="mt-3 text-sm font-medium">Фото рецепта</p></div>
        </div>
        <div class="flex flex-1 flex-col justify-between gap-5 p-6">
          <div>
            <div class="mb-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700">#десерт</span>
              <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">#выпечка</span>
            </div>
            <h3 class="font-serif text-3xl font-semibold text-stone-900">Клубничный торт</h3>
            <p class="mt-3 text-sm text-stone-500">⏱️ Время приготовления: 45 минут</p>
          </div>
          <button type="button" class="rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400">
            Открыть рецепт
          </button>
        </div>
      </article>
    </section>
  </div>
</main>
