<main class="min-h-screen bg-stone-50 text-stone-800">
  <div class="mx-auto max-w-4xl space-y-12 p-8">
    <header class="space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-400">Batch Chef</p>
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h1 class="font-serif text-4xl font-semibold text-stone-900">Ваша кухня, ваши рецепты</h1>
          <p class="mt-3 max-w-2xl text-stone-600">
            Создавайте рецепты, пересчитывайте ингредиенты под форму и готовьте по шагам.
          </p>
        </div>
        <% if logged_in? %>
          <%= link_to "Мои рецепты", recipes_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% else %>
          <%= link_to "Войти, чтобы сохранять", login_path,
              class: "rounded-xl bg-rose-300 px-5 py-3 text-center font-semibold text-stone-900 shadow-sm hover:bg-rose-400" %>
        <% end %>
      </div>
    </header>

    <section aria-labelledby="recipe-builder-heading" class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="mb-6">
        <h2 id="recipe-builder-heading" class="font-serif text-2xl font-semibold text-stone-900">
          Конструктор рецепта
        </h2>
        <p class="mt-1 text-sm text-stone-500">
          Заполните данные и сохраните рецепт в разделе «Мои рецепты».
        </p>
      </div>

      <%= form_with model: @recipe, url: recipes_path, class: "space-y-6" do |form| %>
        <% if @recipe.errors.any? %>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
            <ul class="list-disc pl-5">
              <% @recipe.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title, "Название рецепта", class: "mb-2 block font-medium text-stone-800" %>
          <%= form.text_field :title, placeholder: "Например: Лимонный тарт",
              class: "w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 outline-none focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <p class="mt-2 text-sm text-stone-500">Название будет видно в списке ваших рецептов.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :base_diameter, "Диаметр формы, см", class: "mb-2 block font-medium text-stone-800" %>
            <%= form.number_field :base_diameter, min: 0, step: 0.1, placeholder: "18",
                class: "w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 outline-none focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
            <p class="mt-2 text-sm text-stone-500">Для пересчёта количества ингредиентов.</p>
          </div>
          <div>
            <%= form.label :base_portions, "Количество порций, шт.", class: "mb-2 block font-medium text-stone-800" %>
            <%= form.number_field :base_portions, min: 0, step: 1, placeholder: "6",
                class: "w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 outline-none focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          </div>
        </div>

        <div>
          <div class="mb-3 flex items-center justify-between gap-3">
            <div>
              <h3 class="font-semibold text-stone-900">Ингредиенты</h3>
              <p class="text-sm text-stone-500">Добавьте продукты и их количество.</p>
            </div>
            <button type="button" id="add-home-ingredient"
                class="rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:border-rose-300 hover:bg-rose-50">
              + Добавить ингредиент
            </button>
          </div>

          <div id="home-ingredients-fields" class="space-y-3">
            <%= form.fields_for :ingredients do |ingredient_form| %>
              <div class="home-ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
                <%= ingredient_form.text_field :name, placeholder: "Например, сахар",
                    class: "rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                <%= ingredient_form.number_field :amount, step: 0.01, placeholder: "Количество",
                    class: "rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                <%= ingredient_form.text_field :unit, placeholder: "г / кг",
                    class: "rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                <button type="button" class="remove-home-ingredient rounded-lg px-2 py-2 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">
                  Удалить
                </button>
              </div>
            <% end %>
          </div>
          <p class="mt-2 text-sm text-stone-500">Каждая добавленная строка сохранится вместе с рецептом.</p>
        </div>

        <div class="flex flex-col items-start justify-between gap-4 border-t border-stone-200 pt-6 sm:flex-row sm:items-center">
          <p class="text-sm text-stone-500">
            <% if logged_in? %>
              После сохранения рецепт откроется на отдельной странице.
            <% else %>
              Для сохранения рецепта сначала войдите в аккаунт.
            <% end %>
          </p>
          <%= form.submit "Сохранить рецепт",
              class: "w-full rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 shadow-sm hover:bg-rose-400 sm:w-auto" %>
        </div>
      <% end %>
    </section>

    <section aria-labelledby="catalog-heading" class="space-y-4">
      <div>
        <h2 id="catalog-heading" class="font-serif text-2xl font-semibold text-stone-900">Каталог</h2>
        <p class="mt-1 text-sm text-stone-500">Пример карточки рецепта Batch Chef.</p>
      </div>
      <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm sm:flex">
        <div class="flex min-h-56 items-center justify-center bg-rose-100 px-8 text-center text-rose-500 sm:w-2/5">
          <div><span class="text-5xl" aria-hidden="true">🍓</span><p class="mt-3 text-sm font-medium">Фото рецепта</p></div>
        </div>
        <div class="flex flex-1 flex-col justify-between gap-5 p-6">
          <div>
            <div class="mb-3 flex flex-wrap gap-2">
              <span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700">#десерт</span>
              <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">#выпечка</span>
            </div>
            <h3 class="font-serif text-3xl font-semibold text-stone-900">Клубничный торт</h3>
            <p class="mt-3 text-sm text-stone-500">⏱️ Время приготовления: 45 минут</p>
          </div>
          <button type="button" class="rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400">
            Открыть рецепт
          </button>
        </div>
      </article>
    </section>
  </div>
</main>

<template id="home-ingredient-template">
  <div class="home-ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
    <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][name]" placeholder="Например, сахар"
        class="rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <input type="number" step="0.01" name="recipe[ingredients_attributes][NEW_RECORD][amount]" placeholder="Количество"
        class="rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][unit]" placeholder="г / кг"
        class="rounded-lg border border-stone-300 bg-white px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <button type="button" class="remove-home-ingredient rounded-lg px-2 py-2 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">Удалить</button>
  </div>
</template>

<script>
  (() => {
    const addButton = document.getElementById("add-home-ingredient");
    const fields = document.getElementById("home-ingredients-fields");
    const template = document.getElementById("home-ingredient-template");

    if (!addButton || !fields || !template) return;

    addButton.addEventListener("click", () => {
      const key = Date.now().toString();
      fields.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", key));
    });

    fields.addEventListener("click", (event) => {
      if (event.target.classList.contains("remove-home-ingredient")) {
        event.target.closest(".home-ingredient-row").remove();
      }
    });
  })();
</script>
