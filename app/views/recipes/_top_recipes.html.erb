<%= turbo_stream_from "top_recipes" %>
<%= turbo_frame_tag "top_recipes" do %>
  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Топ-3 рецепта</h2>
    <ol class="mt-4 space-y-3">
      <% recipes = local_assigns.fetch(:recipes) { Recipe.published.order(likes_count: :desc, created_at: :desc).limit(3) } %>
      <% recipes.each do |recipe| %>
        <li class="grid grid-cols-[3.5rem_minmax(0,1fr)_auto] items-center gap-3 border-b border-stone-200 pb-3 last:border-b-0 last:pb-0">
          <% if recipe.photo.attached? %>
            <%= image_tag recipe.photo, class: "h-14 w-14 rounded-lg object-cover", alt: recipe.title %>
          <% else %>
            <div class="h-14 w-14 rounded-lg bg-stone-100" aria-hidden="true"></div>
          <% end %>
          <%= link_to recipe.title, recipe_path(recipe),
              class: "min-w-0 break-words text-rose-600 underline" %>
          <span class="whitespace-nowrap text-sm text-stone-500"><%= recipe.likes_count %> ♥</span>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
