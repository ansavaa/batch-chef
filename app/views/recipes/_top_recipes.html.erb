<%= turbo_stream_from "top_recipes" %>
<%= turbo_frame_tag "top_recipes" do %>
  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Топ-3 рецепта</h2>
    <ol class="mt-4 space-y-3">
      <% recipes = local_assigns.fetch(:recipes) { Recipe.published.order(likes_count: :desc, created_at: :desc).limit(3) } %>
      <% recipes.each do |recipe| %>
        <li class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <% if recipe.photo.attached? %>
              <%= image_tag recipe.photo, class: "h-12 w-12 rounded-lg object-cover", alt: recipe.title %>
            <% end %>
            <%= link_to recipe.title, recipe_path(recipe), class: "text-rose-600 underline" %>
          </div>
          <span class="text-sm text-stone-500"><%= recipe.likes_count %> ♥</span>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
