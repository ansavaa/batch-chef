<%= form_with model: recipe, class: "space-y-6" do |form| %>
  <% if recipe.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
      <ul class="list-disc pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Название рецепта", class: "mb-2 block font-medium text-stone-800" %>
    <%= form.text_field :title, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :base_diameter, "Диаметр формы, см", class: "mb-2 block font-medium text-stone-800" %>
      <%= form.number_field :base_diameter, min: 0, step: 0.1, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
    </div>
    <div>
      <%= form.label :base_portions, "Количество порций, шт.", class: "mb-2 block font-medium text-stone-800" %>
      <%= form.number_field :base_portions, min: 0, step: 1, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
    </div>
  </div>

  <section>
    <div class="mb-3 flex items-center justify-between">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">Ингредиенты</h2>
        <p class="text-sm text-stone-500">Добавьте название, количество и единицу измерения.</p>
      </div>
      <button type="button" id="add-ingredient" class="rounded-xl border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-rose-50">
        + Добавить ингредиент
      </button>
    </div>

    <div id="ingredients-fields" class="space-y-3">
      <%= form.fields_for :ingredients do |ingredient_form| %>
        <div class="ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
          <%= ingredient_form.text_field :name, placeholder: "Например, сахар", class: "rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= ingredient_form.number_field :amount, step: 0.01, placeholder: "Количество", class: "rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= ingredient_form.select :unit, [["г", "g"], ["кг", "kg"], ["мл", "ml"], ["л", "l"]], { prompt: "Единица" }, class: "rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= ingredient_form.hidden_field :_destroy, value: "0", class: "destroy-field" %>
          <button type="button" class="remove-ingredient rounded-lg px-2 py-2 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">
            Удалить
          </button>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <div class="mb-3 flex items-center justify-between gap-3">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">Шаги приготовления</h2>
        <p class="text-sm text-stone-500">Опишите последовательность действий.</p>
      </div>
      <button type="button" id="add-step" class="rounded-xl border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-rose-50">
        + Добавить шаг
      </button>
    </div>
    <div id="steps-fields" class="space-y-3">
      <%= form.fields_for :steps do |step_form| %>
        <div class="step-row rounded-xl border border-stone-200 bg-stone-50 p-4">
          <%= step_form.text_area :description, rows: 2, placeholder: "Например, взбейте яйца с сахаром", class: "w-full rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= step_form.hidden_field :is_completed, value: "0" %>
          <%= step_form.hidden_field :_destroy, value: "0", class: "step-destroy-field" %>
          <button type="button" class="remove-step mt-2 rounded-lg px-2 py-1 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">
            Удалить шаг
          </button>
        </div>
      <% end %>
    </div>
  </section>

  <%= form.submit "Сохранить рецепт", class: "rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400" %>
<% end %>

<template id="ingredient-template">
  <div class="ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
    <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][name]" placeholder="Например, сахар" class="rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <input type="number" step="0.01" name="recipe[ingredients_attributes][NEW_RECORD][amount]" placeholder="Количество" class="rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <select name="recipe[ingredients_attributes][NEW_RECORD][unit]" class="rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
      <option value="">Единица</option>
      <option value="g">г</option>
      <option value="kg">кг</option>
      <option value="ml">мл</option>
      <option value="l">л</option>
    </select>
    <input type="hidden" name="recipe[ingredients_attributes][NEW_RECORD][_destroy]" value="0">
    <button type="button" class="remove-ingredient rounded-lg px-2 py-2 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">Удалить</button>
  </div>
</template>

<template id="step-template">
  <div class="step-row rounded-xl border border-stone-200 bg-stone-50 p-4">
    <textarea name="recipe[steps_attributes][NEW_RECORD][description]" rows="2" placeholder="Например, взбейте яйца с сахаром" class="w-full rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200"></textarea>
    <input type="hidden" name="recipe[steps_attributes][NEW_RECORD][is_completed]" value="0">
    <input type="hidden" name="recipe[steps_attributes][NEW_RECORD][_destroy]" value="0" class="step-destroy-field">
    <button type="button" class="remove-step mt-2 rounded-lg px-2 py-1 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">Удалить шаг</button>
  </div>
</template>

<script>
  (() => {
    const addButton = document.getElementById("add-ingredient");
    const fields = document.getElementById("ingredients-fields");
    const template = document.getElementById("ingredient-template");

    if (!addButton || !fields || !template) return;

    addButton.addEventListener("click", () => {
      const key = Date.now().toString();
      fields.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", key));
    });

    fields.addEventListener("click", (event) => {
      if (!event.target.classList.contains("remove-ingredient")) return;

      const row = event.target.closest(".ingredient-row");
      const destroyField = row.querySelector(".destroy-field");

      if (destroyField) {
        destroyField.value = "1";
        row.hidden = true;
      } else {
        row.remove();
      }
    });

    const addStepButton = document.getElementById("add-step");
    const stepsFields = document.getElementById("steps-fields");
    const stepTemplate = document.getElementById("step-template");

    if (!addStepButton || !stepsFields || !stepTemplate) return;

    addStepButton.addEventListener("click", () => {
      const key = Date.now().toString();
      stepsFields.insertAdjacentHTML("beforeend", stepTemplate.innerHTML.replaceAll("NEW_RECORD", key));
    });

    stepsFields.addEventListener("click", (event) => {
      if (!event.target.classList.contains("remove-step")) return;

      const row = event.target.closest(".step-row");
      const destroyField = row.querySelector(".step-destroy-field");

      if (destroyField) {
        destroyField.value = "1";
        row.hidden = true;
      } else {
        row.remove();
      }
    });
  })();
</script>
