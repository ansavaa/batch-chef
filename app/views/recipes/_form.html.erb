<%= form_with model: recipe, class: "space-y-6" do |form| %>
  <% if recipe.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
      <ul class="list-disc pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Название рецепта",
        class: "mb-2 block font-medium text-stone-800" %>
    <%= form.text_field :title,
        class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
  </div>

  <div>
    <%= form.label :base_diameter, "Диаметр формы, см",
        class: "mb-2 block font-medium text-stone-800" %>
    <%= form.number_field :base_diameter, min: 0, step: 0.1,
        class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
  </div>

  <div>
    <%= form.label :base_portions, "Количество порций, шт.",
        class: "mb-2 block font-medium text-stone-800" %>
    <%= form.number_field :base_portions, min: 0, step: 1,
        class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
  </div>

  <%= form.submit "Сохранить рецепт",
      class: "rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400" %>
<% end %>
