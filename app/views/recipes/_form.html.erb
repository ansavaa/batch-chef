<%= form_with model: recipe, html: { multipart: true }, class: "space-y-6" do |form| %>
  <% if recipe.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
      <ul class="list-disc pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Название рецепта", class: "mb-2 block font-medium text-stone-800" %>
    <%= form.text_field :title, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
  </div>

  <div>
    <%= form.label :photo, "Фотография рецепта", class: "mb-2 block font-medium text-stone-800" %>
    <%= form.file_field :photo, accept: "image/*",
        class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3" %>
    <% if recipe.persisted? && recipe.photo.attached? %>
      <%= image_tag recipe.photo, class: "mt-3 h-40 w-full rounded-xl object-cover", alt: recipe.title %>
    <% end %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :base_diameter, "Диаметр формы, см", class: "mb-2 block font-medium text-stone-800" %>
      <%= form.number_field :base_diameter, min: 0, step: 0.1, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
    </div>
    <div>
      <%= form.label :base_portions, "Количество порций, шт.", class: "mb-2 block font-medium text-stone-800" %>
      <%= form.number_field :base_portions, min: 0, step: 1, class: "w-full rounded-xl border border-stone-300 px-4 py-3 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
    </div>
  </div>

  <section>
    <div class="mb-3 flex items-center justify-between">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">Ингредиенты</h2>
        <p class="text-sm text-stone-500">Добавьте ингредиенты или объедините их в необязательные группы.</p>
      </div>
      <div>
        <button type="button" id="add-group" class="rounded-xl border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-rose-50">
          + Добавить группу
        </button>
      </div>
    </div>

    <div id="ingredients-fields" class="space-y-3">
      <% recipe.ingredients.group_by { |ingredient| ingredient.stage.to_s.strip.presence }.each do |stage, ingredients| %>
        <div class="ingredient-group rounded-2xl border border-stone-200 bg-stone-50 p-4" data-group-name="<%= stage %>">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <% if stage %>
              <%= text_field_tag nil, stage, placeholder: "Например, крем", class: "ingredient-group-name w-full rounded-lg border border-stone-300 bg-white px-3 py-2 font-medium focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
            <% else %>
              <span class="font-medium text-stone-700">Ингредиенты без группы</span>
            <% end %>
            <div class="flex gap-2">
              <button type="button" class="add-group-ingredient rounded-lg bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-rose-100">
                + Ингредиент
              </button>
              <% if stage %>
                <button type="button" class="remove-group rounded-lg px-3 py-2 text-sm text-rose-600 hover:bg-rose-100">
                  Удалить группу
                </button>
              <% end %>
            </div>
          </div>
          <div class="ingredient-group-fields space-y-3">
            <% ingredients.each do |ingredient| %>
              <%= form.fields_for :ingredients, ingredient do |ingredient_form| %>
                <div class="ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-white p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
                  <%= ingredient_form.text_field :name, placeholder: "Например, сахар", class: "min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                  <%= ingredient_form.number_field :amount, step: 0.01, placeholder: "Количество", class: "min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                  <%= ingredient_form.select :unit, [["г", "g"], ["кг", "kg"], ["мл", "ml"], ["л", "l"]], { prompt: "Единица" }, class: "min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
                  <%= ingredient_form.hidden_field :stage, value: stage, class: "ingredient-stage" %>
                  <%= ingredient_form.hidden_field :_destroy, value: "0", class: "destroy-field" %>
                  <button type="button" class="remove-ingredient rounded-lg px-2 py-2 text-lg leading-none text-stone-500 hover:bg-rose-50 hover:text-rose-600" aria-label="Удалить ингредиент" title="Удалить ингредиент">
                    ×
                  </button>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <div class="mb-3 flex items-center justify-between gap-3">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">Шаги приготовления</h2>
        <p class="text-sm text-stone-500">Опишите последовательность действий.</p>
      </div>
      <button type="button" id="add-step" class="rounded-xl border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-rose-50">
        + Добавить шаг
      </button>
    </div>
    <div id="steps-fields" class="space-y-3">
      <%= form.fields_for :steps do |step_form| %>
        <div class="step-row rounded-xl border border-stone-200 bg-stone-50 p-4">
          <%= step_form.text_area :description, rows: 2, placeholder: "Например, взбейте яйца с сахаром", class: "w-full rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= step_form.hidden_field :is_completed, value: "0" %>
          <%= step_form.hidden_field :_destroy, value: "0", class: "step-destroy-field" %>
          <button type="button" class="remove-step mt-2 rounded-lg px-2 py-1 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">
            Удалить шаг
          </button>
        </div>
      <% end %>
    </div>
  </section>

  <%= form.submit "Сохранить рецепт", class: "rounded-xl bg-rose-300 px-5 py-3 font-semibold text-stone-900 hover:bg-rose-400" %>
<% end %>

<template id="ingredient-template">
  <div class="ingredient-row grid gap-3 rounded-xl border border-stone-200 bg-white p-4 sm:grid-cols-[1fr_8rem_7rem_auto]">
    <input type="text" name="recipe[ingredients_attributes][NEW_RECORD][name]" placeholder="Например, сахар" class="min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <input type="number" step="0.01" name="recipe[ingredients_attributes][NEW_RECORD][amount]" placeholder="Количество" class="min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
    <select name="recipe[ingredients_attributes][NEW_RECORD][unit]" class="min-w-0 rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
      <option value="">Единица</option>
      <option value="g">г</option>
      <option value="kg">кг</option>
      <option value="ml">мл</option>
      <option value="l">л</option>
    </select>
    <input type="hidden" name="recipe[ingredients_attributes][NEW_RECORD][stage]" value="" class="ingredient-stage">
    <input type="hidden" name="recipe[ingredients_attributes][NEW_RECORD][_destroy]" value="0">
    <button type="button" class="remove-ingredient rounded-lg px-2 py-2 text-lg leading-none text-stone-500 hover:bg-rose-50 hover:text-rose-600" aria-label="Удалить ингредиент" title="Удалить ингредиент">×</button>
  </div>
</template>

<template id="group-template">
  <div class="ingredient-group rounded-2xl border border-rose-200 bg-rose-50 p-4" data-group-name="">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <input type="text" placeholder="Название группы, например крем" class="ingredient-group-name w-full rounded-lg border border-stone-300 bg-white px-3 py-2 font-medium focus:border-rose-300 focus:ring-2 focus:ring-rose-200">
      <div class="flex gap-2">
        <button type="button" class="add-group-ingredient rounded-lg bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-rose-100">+ Ингредиент</button>
        <button type="button" class="remove-group rounded-lg px-3 py-2 text-sm text-rose-600 hover:bg-rose-100">Удалить группу</button>
      </div>
    </div>
    <div class="ingredient-group-fields space-y-3"></div>
  </div>
</template>

<template id="step-template">
  <div class="step-row rounded-xl border border-stone-200 bg-stone-50 p-4">
    <textarea name="recipe[steps_attributes][NEW_RECORD][description]" rows="2" placeholder="Например, взбейте яйца с сахаром" class="w-full rounded-lg border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200"></textarea>
    <input type="hidden" name="recipe[steps_attributes][NEW_RECORD][is_completed]" value="0">
    <input type="hidden" name="recipe[steps_attributes][NEW_RECORD][_destroy]" value="0" class="step-destroy-field">
    <button type="button" class="remove-step mt-2 rounded-lg px-2 py-1 text-sm text-stone-500 hover:bg-rose-50 hover:text-rose-600">Удалить шаг</button>
  </div>
</template>

<script>
  (() => {
    const fields = document.getElementById("ingredients-fields");
    const template = document.getElementById("ingredient-template");
    const groupTemplate = document.getElementById("group-template");

    if (!fields || !template || !groupTemplate) return;

    const syncGroupName = (group) => {
      const name = group.querySelector(".ingredient-group-name")?.value.trim() || "";
      group.dataset.groupName = name;
      group.querySelectorAll(".ingredient-stage").forEach((field) => { field.value = name; });
    };

    const addIngredient = (group) => {
      const key = Date.now().toString();
      group.querySelector(".ingredient-group-fields")
        .insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", key));
      syncGroupName(group);
    };

    const addGroup = () => {
      fields.insertAdjacentHTML("beforeend", groupTemplate.innerHTML);
      const group = fields.lastElementChild;
      group.querySelector(".ingredient-group-name").focus();
      addIngredient(group);
    };

    document.getElementById("add-group").addEventListener("click", addGroup);

    fields.addEventListener("input", (event) => {
      if (event.target.classList.contains("ingredient-group-name")) {
        syncGroupName(event.target.closest(".ingredient-group"));
      }
    });

    fields.closest("form").addEventListener("submit", () => {
      fields.querySelectorAll(".ingredient-group").forEach(syncGroupName);
    });

    fields.addEventListener("click", (event) => {
      if (event.target.classList.contains("add-group-ingredient")) {
        const group = event.target.closest(".ingredient-group");
        addIngredient(group);
        return;
      }
      if (event.target.classList.contains("remove-group")) {
        const group = event.target.closest(".ingredient-group");
        const hasSavedIngredients = group.querySelector('input[name*="[id]"]');
        if (hasSavedIngredients) {
          group.querySelectorAll(".destroy-field").forEach((field) => { field.value = "1"; });
          group.hidden = true;
        } else {
          group.remove();
        }
        return;
      }
      if (!event.target.classList.contains("remove-ingredient")) return;

      const row = event.target.closest(".ingredient-row");
      const destroyField = row.querySelector(".destroy-field");

      if (destroyField) {
        destroyField.value = "1";
        row.hidden = true;
      } else {
        row.remove();
      }
    });

    const addStepButton = document.getElementById("add-step");
    const stepsFields = document.getElementById("steps-fields");
    const stepTemplate = document.getElementById("step-template");

    if (!addStepButton || !stepsFields || !stepTemplate) return;

    addStepButton.addEventListener("click", () => {
      const key = Date.now().toString();
      stepsFields.insertAdjacentHTML("beforeend", stepTemplate.innerHTML.replaceAll("NEW_RECORD", key));
    });

    stepsFields.addEventListener("click", (event) => {
      if (!event.target.classList.contains("remove-step")) return;

      const row = event.target.closest(".step-row");
      const destroyField = row.querySelector(".step-destroy-field");

      if (destroyField) {
        destroyField.value = "1";
        row.hidden = true;
      } else {
        row.remove();
      }
    });
  })();
</script>
