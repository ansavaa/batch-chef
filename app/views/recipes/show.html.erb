<main class="mx-auto max-w-3xl space-y-8 px-6 py-10">
  <%= turbo_stream_from @recipe %>
  <%= turbo_stream_from [@recipe, :comments] %>

  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-serif text-4xl font-semibold text-stone-900"><%= @recipe.title %></h1>
      <% if @recipe.photo.attached? %>
        <%= image_tag @recipe.photo, class: "mt-4 h-56 w-full rounded-xl object-cover", alt: @recipe.title %>
      <% end %>
      <p class="mt-2 text-stone-600">
        Форма: <%= @recipe.base_diameter.presence || "—" %> см ·
        Порции: <%= @recipe.base_portions.presence || "—" %>
      </p>
    </div>
    <%= link_to "К каталогу", public_recipes_path,
        class: "shrink-0 whitespace-nowrap rounded-xl bg-rose-100 px-4 py-2 font-medium text-rose-700 hover:bg-rose-200" %>
  </div>

  <div class="flex flex-wrap items-center gap-4 text-sm text-stone-500">
    <span>Просмотры: <strong id="recipe_views"><%= @recipe.views_count %></strong></span>
    <span>Лайки: <strong id="recipe_likes"><%= render "likes_count", recipe: @recipe %></strong></span>
    <% if @current_user %>
      <%= render "like_button", recipe: @recipe, liked: @liked %>
    <% else %>
      <%= link_to "Войдите, чтобы поставить лайк", login_path, class: "text-rose-600 underline" %>
    <% end %>
  </div>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Ингредиенты</h2>
    <ul class="mt-4 divide-y divide-stone-100">
      <% @recipe.ingredients.each do |ingredient| %>
        <li class="flex justify-between gap-4 py-3">
          <span><%= ingredient.name %></span>
          <span class="text-stone-500"><%= ingredient.amount %> <%= ingredient.unit %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Пересчитать ингредиенты</h2>
    <p class="mt-2 text-sm text-stone-500">Введите новый параметр формы или количество порций.</p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <%= form_with url: recipe_path(@recipe), method: :get, class: "space-y-2" do |form| %>
        <%= form.label :target_diameter, "Новый диаметр, см", class: "block font-medium" %>
        <div class="flex gap-2">
          <%= form.number_field :target_diameter, min: 0, step: 0.1, required: true, class: "w-full rounded-xl border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= form.submit "Рассчитать", class: "rounded-xl bg-rose-300 px-3 py-2 font-medium hover:bg-rose-400" %>
        </div>
      <% end %>

      <%= form_with url: recipe_path(@recipe), method: :get, class: "space-y-2" do |form| %>
        <%= form.label :target_portions, "Новые порции, шт.", class: "block font-medium" %>
        <div class="flex gap-2">
          <%= form.number_field :target_portions, min: 0, step: 1, required: true, class: "w-full rounded-xl border border-stone-300 px-3 py-2 focus:border-rose-300 focus:ring-2 focus:ring-rose-200" %>
          <%= form.submit "Рассчитать", class: "rounded-xl bg-rose-300 px-3 py-2 font-medium hover:bg-rose-400" %>
        </div>
      <% end %>
    </div>

    <% if @scaled_ingredients.any? %>
      <div class="mt-6 rounded-xl bg-stone-50 p-4">
        <h3 class="font-semibold text-stone-900">Результат пересчёта</h3>
        <ul class="mt-3 divide-y divide-stone-200">
          <% @scaled_ingredients.each do |ingredient| %>
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <span class="font-medium"><%= ingredient[:name] %></span>
              <span class="text-sm text-stone-600">
                <%= ingredient[:amount].round(2) %> <%= ingredient[:unit] %>
                · <%= ingredient[:api][:amount_lb] %> lb
                · <%= ingredient[:api][:total_cost] %> <%= ingredient[:api][:currency] %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Режим готовки</h2>
    <p class="mt-2 text-sm text-stone-500">Отмечайте выполненные шаги во время приготовления.</p>
    <div class="mt-4 space-y-3">
      <% @recipe.steps.order(:order_index, :id).each do |step| %>
        <label class="flex cursor-pointer items-center gap-3 rounded-xl bg-stone-50 p-4">
          <input type="checkbox" <%= "checked" if step.is_completed %> class="peer h-5 w-5 accent-rose-300">
          <span class="peer-checked:text-stone-500 peer-checked:line-through"><%= step.description %></span>
        </label>
      <% end %>
    </div>
    <button type="button" class="mt-5 rounded-xl bg-stone-200 px-5 py-3 font-semibold text-stone-800 hover:bg-stone-300">
      ⏱️ Запустить таймер
    </button>
  </section>

  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="font-serif text-2xl font-semibold text-stone-900">Комментарии</h2>
    <div id="comments" class="mt-4 space-y-3">
      <% comments = @recipe.comments.includes(:user).order(created_at: :desc) %>
      <%= render comments.limit(3) %>

      <% if comments.size > 3 %>
        <details class="rounded-xl border border-stone-200 bg-stone-50 p-4">
          <summary class="cursor-pointer font-medium text-rose-600">
            Показать остальные комментарии (<%= comments.size - 3 %>)
          </summary>
          <div class="mt-4 space-y-3">
            <%= render comments.offset(3) %>
          </div>
        </details>
      <% end %>
    </div>

    <% if @current_user %>
      <div class="mt-6">
        <%= render "comments/form", recipe: @recipe, comment: @recipe.comments.build %>
      </div>
    <% else %>
      <%= link_to "Войдите, чтобы оставить комментарий", login_path,
          class: "mt-6 inline-block text-rose-600 underline" %>
    <% end %>
  </section>

</main>
