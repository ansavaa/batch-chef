<main class="mx-auto max-w-2xl px-6 py-10">
  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="font-serif text-4xl font-semibold text-stone-900"><%= @recipe.title %></h1>

    <dl class="mt-6 space-y-3 text-stone-700">
      <div class="flex justify-between border-b border-stone-100 pb-3">
        <dt>Диаметр формы</dt>
        <dd><%= @recipe.base_diameter.presence || "Не указан" %> см</dd>
      </div>
      <div class="flex justify-between border-b border-stone-100 pb-3">
        <dt>Количество порций</dt>
        <dd><%= @recipe.base_portions.presence || "Не указано" %></dd>
      </div>
    </dl>

    <%= link_to "Вернуться к рецептам", recipes_path,
        class: "mt-6 inline-block text-rose-600 underline" %>
  </div>
</main>
